# mony-home environment configuration
# Copy this file to .env.local and fill in the values you need.
# Every variable is optional unless stated otherwise; defaults live in src/lib/config.ts.

# --- Database (Supabase Postgres) ---
# Application connection string (pooled, e.g. the Supabase pooler URL).
# Optional for now; required once the database phase lands.
DATABASE_URL=
# Direct (non-pooled) connection string, reserved for schema migrations.
DIRECT_URL=

# --- LLM / AI assistant (OpenRouter, OpenAI-compatible API) ---
# Base URL of the OpenAI-compatible endpoint. Defaults to https://openrouter.ai/api/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# API key from https://openrouter.ai/keys (free tier is enough to start).
LLM_API_KEY=
# Model identifier for the finance assistant (e.g. an OpenRouter free-tier model id).
LLM_MODEL=
# Max assistant requests per user per day. Must be a positive integer. Default: 8
ASSISTANT_DAILY_LIMIT=8

# --- App ---
# Human-readable app name. Later also sent to OpenRouter as attribution:
# X-Title uses APP_NAME; HTTP-Referer will use the deployed site URL.
APP_NAME=mony-home
# Secret used to sign sessions once authentication lands.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=
